def _load_run_matches(ws, run_id):
    """Read evaluated postings for a run; attach detail text when present."""
    log = os.path.join(ws, "jobs.jsonl")
    judged = []
    details = {}
    if os.path.exists(log):
        with open(log, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if o.get("run_id") != run_id:
                    continue
                if o.get("event") == "detail":
                    details[(str(o.get("source")), str(o.get("source_id")))] = o
                elif o.get("event") == "evaluated":
                    judged.append(o)
    return judged, details


def _slugify(s):
    s = re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")
    return s[:60] or "job"


def normalize_salary(disp, text):
    """Best-effort salary normalization. Returns a short canonical band string."""
    joined = " ".join(x for x in (disp, (text or "")[:2500]) if x)
    if not joined:
        return ""
    # Indian: ₹/Rs/INR with optional LPA/Lakh and a range
    m = re.search(
        r"(?:₹|Rs\.?|INR)\s*([\d,]+(?:\.[\d]+)?)\s*(?:-|–|to)"
        r"\s*(?:₹|Rs\.?)?\s*([\d,]+(?:\.[\d]+)?)\s*(LPA|Lakh|Lacs?|per annum|p\.?a\.?|/year)?",
        joined, re.I)
    if m:
        lo = float(m.group(1).replace(",", ""))
        hi = float(m.group(2).replace(",", ""))
        unit = (m.group(3) or "").lower()
        if "l" in unit and "la" in unit or unit.startswith("l"):
            lo, hi = lo, hi  # already lakh units
            u = "LPA"
        elif "per annum" in unit or "p.a" in unit or "/year" in unit:
            u = "yr"
        else:
            # numbers like 4–8 without unit: treat as lakh if < 50
            if hi <= 50 and lo >= 1:
                u = "LPA"
            else:
                u = ""
        return f"₹{lo:g}–{hi:g} {u}".replace("₹4–8 LPA" if False else " ", " ").strip()
    m = re.search(
        r"\$\s*([\d,]+(?:\.[\d]+)?)\s*(?:-|–|to)\s*(?:\$)?\s*([\d,]+(?:\.[\d]+)?)"
        r"\s*(k|K|thousand)?\s*(per year|/yr|/year)?", joined)
    if m:
        lo = float(m.group(1).replace(",", ""))
        hi = float(m.group(2).replace(",", ""))
        k = m.group(3)
        if k:
            lo *= 1000; hi *= 1000
        return f"${lo/1000:g}–{hi/1000:g}K/yr"
    # single value fallback
    m = re.search(r"(?:₹|Rs\.?|INR)\s*([\d,]+(?:\.[\d]+)?)\s*(LPA|Lakh|Lacs?)?", joined, re.I)
    if m:
        return f"₹{m.group(1)} {m.group(2) or ''}".strip()
    return disp or ""


def _company_registry():
    reg = load_registry()
    companies = []
    for src, slugs in reg.items():
        for s in slugs:
            companies.append((src, s, re.sub(r"[-_]", " ", s)))
    return companies


def company_snapshot(company_name):
    """Best-effort: careers URL from matched board slug + LinkedIn company link."""
    name = re.sub(r"[^a-z0-9 ]", "", company_name.lower()).strip()
    if not name:
        return {"careers_url": "", "board": "", "linkedin_search": ""}
    best = None
    for src, slug, pretty in _company_registry():
        if name == pretty or (name in pretty and len(name) >= 4):
            best = (src, slug)
            break
    careers_url = ""
    board = ""
    if best:
        src, slug = best
        board = src
        if src == "greenhouse":
            careers_url = f"https://boards.greenhouse.io/{slug}"
        elif src == "ashby":
            careers_url = f"https://jobs.ashbyhq.com/{slug}"
        elif src == "lever":
            careers_url = f"https://jobs.lever.co/{slug}"
    li = "https://www.linkedin.com/company/search?keywords=" + urllib.parse.quote(company_name)
    return {"careers_url": careers_url, "board": board, "linkedin_search": li}


def _repost_groups(judged):
    """Group by normalized title+company; flag later duplicates as reposts."""
    groups = {}
    for o in judged:
        key = hashlib.sha1(
            (re.sub(r"\W+", " ", o.get("title", "")).strip().lower()
             + "|" + re.sub(r"\W+", " ", o.get("company_name", "")).strip().lower())
            .encode()).hexdigest()
        groups.setdefault(key, []).append(o)
    repost = {}
    for key, items in groups.items():
        if len(items) > 1:
            first = items[0]["source_id"]
            for o in items[1:]:
                repost[str(o["source_id"])] = first
    return repost


def cmd_report():
    ws = flag(sys.argv[2:], "--workspace") or os.path.join(os.path.expanduser("~"), ".job-search")
    run_id = flag(sys.argv[2:], "--run-id") or ""
    outdir = flag(sys.argv[2:], "--out") or os.path.join(ws, "reports", "matches")
    os.makedirs(outdir, exist_ok=True)
    if not run_id:
        runs = sorted(d for d in os.listdir(os.path.join(ws, "runs")) if d.endswith(".json"))
        if not runs:
            err("usage", "no runs found; pass --run-id", False)
        run_id = runs[-1][:-5]
    judged, details = _load_run_matches(ws, run_id)
    if not judged:
        err("usage", f"no judged postings for run {run_id}", False)
    repost = _repost_groups(judged)
    rows = []
    for o in judged:
        sid = str(o.get("source_id"))
        det = details.get((str(o.get("source")), sid), {})
        desc = det.get("description_markdown") or ""
        sal = normalize_salary(o.get("salary_display"), desc)
        snap = company_snapshot(o.get("company_name", ""))
        rows.append({
            "run_id": run_id, "source": o.get("source"), "source_id": sid,
            "title": o.get("title"), "company": o.get("company_name"),
            "location": o.get("location_display"), "posted_at": o.get("posted_at", ""),
            "relevant": o.get("relevant"), "match": o.get("match") or "",
            "needs_human_check": o.get("needs_human_check") or False,
            "salary": sal, "dealbreakers": "; ".join(o.get("dealbreakers_hit") or []),
            "unknowns": "; ".join(o.get("unknowns") or []),
            "reasoning": o.get("reasoning", ""), "url": o.get("source_url", ""),
            "is_repost": str(sid) in repost, "repost_of": repost.get(str(sid), ""),
            "careers_url": snap["careers_url"], "board": snap["board"],
            "linkedin_search": snap["linkedin_search"],
        })
    # matches.csv
    csv_path = os.path.join(outdir, "matches.csv")
    cols = list(rows[0].keys())
    with open(csv_path, "w", newline="", encoding="utf-8-sig") as f:
        w = csv.DictWriter(f, fieldnames=cols)
        w.writeheader()
        w.writerows(rows)
    # matches.xlsx when openpyxl is available
    xlsx_path = ""
    try:
        import openpyxl
        wb = openpyxl.Workbook()
        wsx = wb.active
        wsx.title = "matches"
        wsx.append(cols)
        for r in rows:
            wsx.append([r[c] for c in cols])
        xlsx_path = os.path.join(outdir, "matches.xlsx")
        wb.save(xlsx_path)
    except Exception:
        xlsx_path = ""
    # applications.csv tracker (append; never clobber)
    app_path = os.path.join(ws, "reports", "applications.csv")
    new = os.path.exists(app_path)
    with open(app_path, "a", newline="", encoding="utf-8-sig") as f:
        w = csv.writer(f)
        if not new:
            w.writerow(["date_added", "source", "company", "title", "location",
                        "match", "url", "status"])
        for r in rows:
            if r["relevant"] and r["match"] in ("strong", "moderate"):
                w.writerow([time.strftime("%Y-%m-%d"), r["source"], r["company"],
                            r["title"], r["location"], r["match"], r["url"], "applied_pending"])
    # cover letters
    letters_dir = os.path.join(outdir, "cover-letters")
    os.makedirs(letters_dir, exist_ok=True)
    brief = ""
    bpath = os.path.join(ws, "preferences.md")
    if os.path.exists(bpath):
        with open(bpath, encoding="utf-8") as f:
            brief = f.read()[:1600]
    n_letters = 0
    for r in rows:
        if r["relevant"] and r["match"] in ("strong", "moderate"):
            n_letters += 1
            md = (f"# Cover letter — {r['company']}\n\n"
                  f"**Role:** {r['title']} · {r['location']}\n"
                  f"**Match:** {r['match']} · source: {r['source']}\n\n"
                  f"**Why it fits (from your job-search agent):**\n{r['reasoning']}\n\n"
                  f"**Apply:** {r['url']}\n"
                  f"**Careers:** {r['careers_url'] or 'n/a'}\n\n"
                  f"---\n\nDear Hiring Team,\n\n"
                  f"Applying for {r['title']} at {r['company']}. As a QA Test Analyst fresher "
                  f"(manual + automation, Selenium/Java, Postman, SQL, Jira; ISTQB CTFL in progress) "
                  f"I bring what this role asks for. {r['reasoning']}\n\n"
                  f"Best regards,\n{os.environ.get('JOBSEARCH_USER_NAME', 'Your Name')}\n{os.environ.get('JOBSEARCH_USER_EMAIL', 'you@example.com')}\n\n"
                  f"--- Brief reference ---\n{brief}\n")
            with open(os.path.join(letters_dir, _slugify(r["company"]) + ".md"),
                      "w", encoding="utf-8") as f:
                f.write(md)
    print(f"report for run {run_id} → {outdir}")
    print(f"  matches.csv: {len(rows)} rows")
    if xlsx_path:
        print(f"  matches.xlsx: written")
    print(f"  applications.csv: appended ({n_letters} strong/moderate) ")
    print(f"  cover-letters/: {n_letters} drafts")


def _find_aa_cli():
    """Locate the api-anything CLI: env override, PATH, or npm global."""
    env = os.environ.get("API_ANYTHING_CLI")
    if env and os.path.exists(env):
        return env
    exe = shutil.which("api-anything")
    if exe:
        return exe
    try:
        root = subprocess.run(["npm", "root", "-g"], capture_output=True,
                              text=True, timeout=15).stdout.strip()
        if root:
            cand = os.path.join(root, "api-anything", "dist", "cli.js")
            if os.path.exists(cand):
                return cand
    except Exception:
        pass
    return ""


AA_CLI = _find_aa_cli()


def api_anything_call(site, op, params):
    """Call api-anything CLI: `node cli.js call <site> <op> k=v ...`.
    Returns the parsed JSON (ok/class/data/...)."""
    cmd = ["node", AA_CLI, "call", site, op]
    for k, v in params.items():
        if v is not None and str(v) != "":
            cmd.append(f"{k}={v}")
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
    if p.returncode != 0:
        return {"ok": False, "class": "cli", "reason": (p.stderr or p.stdout)[:300]}
    try:
        return json.loads(p.stdout)
    except Exception as e:
        return {"ok": False, "class": "parse", "reason": str(e)}


def _aa_item_to_row(item, site, op, keywords, location):
    """Heuristic mapping of a catalog item to a canonical job row."""
    def pick(*keys):
        for k in keys:
            v = item.get(k)
            if isinstance(v, dict):
                v = v.get("name") or v.get("title") or v.get("displayName")
            if v:
                return str(v)
        return ""
    title = pick("title", "jobTitle", "name", "role", "text", "position")
    company = pick("company", "companyName", "organization", "employer", "org", "disambiguatingDescription")
    loc = pick("location", "locationName", "city", "place", "locations", "office")
    if not loc and not isinstance(item.get("description"), (list, dict)) \
            and len(str(item.get("description") or "")) < 80 \
            and site == "linkedin":
        loc = str(item.get("description") or "")
    if isinstance(item.get("locations"), list):
        loc = "; ".join(str(x.get("name") or x) for x in item["locations"][:3])
    # Naukri-style payload: placeholders[] carries experience/salary/location
    placeholders = item.get("placeholders") or []
    if isinstance(placeholders, list):
        for ph in placeholders:
            label = str(ph.get("label") or "")
            ptype = str(ph.get("type") or "").lower()
            if ptype == "location" and not loc:
                loc = label
            elif ptype == "salary" and not sal_placeholder:
                sal_placeholder = label
    url = pick("url", "applyUrl", "permalink", "link", "absolute_url", "hostedUrl", "jobUrl", "jdURL")
    if url.startswith("/"):
        url = "https://www.naukri.com" + url
    if not url or url.startswith("/"):
        base = pick("baseUrl")
        url = (base.rstrip("/") + "/" + url.lstrip("/")) if base and url else url
    jid = pick("id", "objectID", "jobId", "source_id", "key")
    if not jid:
        jid = hashlib.sha1((site + ":" + title + ":" + company).encode()).hexdigest()[:16]
    posted = pick("posted_at", "created_at", "date", "publication_date", "firstPublishedAt", "updated_at")
    if not posted and item.get("footerPlaceholderLabel"):
        rel = str(item["footerPlaceholderLabel"]).lower()
        posted = _relative_date(rel) or ""
    desc = pick("description", "summary", "text_html", "content", "descriptionPlain", "description_markdown", "jobDescription")
    if not desc and isinstance(item.get("description"), list):
        desc = " ".join(str(x) for x in item["description"][:3])
    comp = item.get("compensationTierSummary") or item.get("salaryRange") or item.get("salary") or ""
    if isinstance(comp, dict):
        comp = f"{comp.get('currency') or ''} {comp.get('min')}–{comp.get('max')} {comp.get('interval') or ''}".strip()
    if not comp and "sal_placeholder" in locals() and sal_placeholder:
        comp = sal_placeholder
    row = _canon({}, f"aa/{site}/{op}", jid, url, title, company, loc,
                 str(comp), "", "", "", None, "", posted, posted, bool(desc))
    row["_desc"] = desc
    return row


def _aa_op_params(site, op, keywords, location):
    """Map our keywords/location to the op's actual parameter names (from the
    packaged site definition or the local learned store)."""
    param_names = []
    home = os.path.expanduser("~")
    site_candidates = []
    if AA_CLI:
        site_candidates.append(os.path.join(os.path.dirname(AA_CLI), "..", "sites", site + ".json"))
    site_candidates.append(os.path.join(home, ".api-anything", "sites", site + ".json"))
    for site_path in site_candidates:
        try:
            with open(site_path, encoding="utf-8") as f:
                site_def = json.load(f)
            for o in site_def.get("operations", []):
                if o.get("name") == op:
                    param_names = [s.get("param") for s in o.get("slots", []) if s.get("param")]
                    break
            if param_names:
                break
        except Exception:
            continue
    params = {}
    for p in param_names:
        pl = p.lower()
        if pl in ("query", "q", "keyword", "keywords", "search", "text") and keywords:
            params[p] = keywords
        elif pl in ("location", "loc", "l", "l1", "city", "place") and location:
            params[p] = location
    if not params and keywords:
        params["query"] = keywords
    return params


def fetch_via_api_anything(source, keywords, location, limit):
    """Generic source: `aa/<site>/<op>` — call any catalog op and map rows."""
    parts = source.split("/")
    if len(parts) < 3:
        return [], f"source must be aa/<site>/<op>, got {source!r}"
    site, op = parts[1], parts[2]
    params = _aa_op_params(site, op, keywords, location)
    res = api_anything_call(site, op, params)
    # honor a single retry when the CLI asks for one (transient 406/5xx)
    if not res.get("ok") and isinstance(res.get("nextCall"), dict) \
            and res["nextCall"].get("action") == "retry":
        ms = int(res.get("retry") or res["nextCall"].get("ms") or 1000) if str(res.get("retry")).isdigit() else 1000
        time.sleep(min(ms / 1000.0, 5.0))
        res = api_anything_call(site, op, params)
    if not res.get("ok"):
        return [], f"api-anything {site}/{op} failed: {res.get('class')}: {res.get('reason')}"
    data = res.get("data") or []
    if isinstance(data, dict):
        data = data.get("itemListElement") or data.get("jobs") or data.get("result") or []
    if not isinstance(data, list):
        return [], "api-anything returned non-list data"
    rows = [_aa_item_to_row(it, site, op, keywords, location) for it in data]
    rows = [r for r in rows if r.get("title") or r.get("source_url")]
    return rows[:limit], None


def normalize_salary(text):
    """Normalize a raw salary string into a readable band (INR/USD)."""
    if not text:
        return ""
    t = str(text).replace(",", "").strip()
    if not t:
        return ""
    # INR LPA / Lakh
    m = re.search(r"₹?\s*(\d+(?:\.\d+)?)\s*(?:-|–|to)\s*₹?\s*(\d+(?:\.\d+)?)\s*(?:LPA|Lakh|L)", t, re.I)
    if m:
        return f"₹{m.group(1)}–{m.group(2)} LPA"
    m = re.search(r"₹?\s*(\d+(?:\.\d+)?)\s*(?:LPA|Lakh|L)", t, re.I)
    if m:
        return f"₹{m.group(1)} LPA"
    # USD K range / single
    m = re.search(r"\$\s*(\d+(?:\.\d+)?)K\s*(?:-|–|to)\s*\$\s*(\d+(?:\.\d+)?)K", t, re.I)
    if m:
        return f"${m.group(1)}K–${m.group(2)}K"
    m = re.search(r"\$\s*(\d+(?:\.\d+)?)K", t, re.I)
    if m:
        return f"${m.group(1)}K"
    # generic two-number range with currency hint
    m = re.search(r"([A-Z$£€₹]?)\s*(\d+(?:\.\d+)?)\s*(?:-|–|to)\s*([A-Z$£€₹]?)\s*(\d+(?:\.\d+)?)", t)
    if m:
        cur = m.group(1) or m.group(3) or "$"
        return f"{cur}{m.group(2)}–{cur}{m.group(4)}"
    return t[:80]


def company_snapshot(source_url, source):
    """Enrich a company row: board slug, board URL, open-role count (from cache)."""
    snap = {"source_board": "", "board_url": "", "open_roles": None}
    if not source_url:
        return snap
    slug = None
    if source == "greenhouse":
        m = re.search(r"boards\.greenhouse\.io/([^/?#]+)", source_url)
        if m:
            slug = m.group(1)
            snap["board_url"] = f"https://boards.greenhouse.io/{slug}"
    elif source == "ashby":
        m = re.search(r"jobs\.ashbyhq\.com/([^/?#]+)", source_url)
        if m:
            slug = m.group(1)
            snap["board_url"] = f"https://jobs.ashbyhq.com/{slug}"
    elif source == "lever":
        m = re.search(r"jobs\.lever\.co/([^/?#]+)", source_url)
        if m:
            slug = m.group(1)
            snap["board_url"] = f"https://jobs.lever.co/{slug}"
    if slug:
        snap["source_board"] = slug
        cached = cache_get(f"{source}:{slug}")
        if isinstance(cached, list):
            snap["open_roles"] = len(cached)
    return snap


def load_matches(ws_path, run_id=None):
    """Read jobs.jsonl -> merged evaluated rows (surfaced fields attached)."""
    events = []
    with open(os.path.join(ws_path, "jobs.jsonl"), encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                events.append(json.loads(line))
            except Exception:
                continue
    surfaced = {}
    for e in events:
        if e.get("event") == "surfaced":
            key = (e.get("run_id"), e.get("source"), str(e.get("source_id")))
            surfaced[key] = e
    rows = []
    for e in events:
        if e.get("event") != "evaluated":
            continue
        if run_id and e.get("run_id") != run_id:
            continue
        key = (e.get("run_id"), e.get("source"), str(e.get("source_id")))
        s = surfaced.get(key, {})
        merged = dict(e)
        for field in ("title", "company_name", "location_display", "salary_display",
                      "source_url", "posted_at"):
            if field not in merged and s.get(field) is not None:
                merged[field] = s.get(field)
        merged.setdefault("title", "")
        merged.setdefault("company_name", "")
        merged.setdefault("source_url", "")
        merged.setdefault("location_display", "")
        merged.setdefault("salary_display", "")
        rows.append(merged)
    return rows


def dedup_matches(rows):
    """Flag near-duplicate/repost postings within the result set (fuzzy title+company)."""
    def norm(s):
        return re.sub(r"[^a-z0-9]+", " ", s.lower()).strip()
    def toks(title, company):
        a = set(norm(title).split())
        b = set(norm(company).split())
        return a | b
    for r in rows:
        r["is_repost"] = False
        r["repost_of"] = ""
    groups = []
    for r in rows:
        key = (str(r.get("company_name", "")).strip().lower(),
               frozenset(toks(r.get("title", ""), r.get("company_name", ""))))
        placed = False
        for g in groups:
            gkey, grew_rows = g
            if gkey[0] == key[0]:
                overlap = len(gkey[1] & key[1])
                union = len(gkey[1] | key[1])
                if union and overlap / union >= 0.75:
                    grew_rows.append(r)
                    placed = True
                    break
        if not placed:
            groups.append((key, [r]))
    for g in groups:
        first = g[1][0]
        for r in g[1][1:]:
            r["is_repost"] = True
            r["repost_of"] = f"{first.get('source')}:{first.get('source_id')}"
    return rows


def cmd_export_matches():
    ws = flag(sys.argv[2:], "--workspace") or os.path.expanduser("~/.job-search")
    out = flag(sys.argv[2:], "--out") or ""
    run_id = flag(sys.argv[2:], "--run-id")
    fmt = flag(sys.argv[2:], "--format") or "csv"
    if not out:
        out = os.path.join(ws, "reports", f"matches-{datetime.now(timezone.utc).strftime('%Y-%m-%d')}.csv")
    rows = dedup_matches(load_matches(ws, run_id))
    header = ["source", "source_id", "title", "company", "company_board", "board_url",
              "open_roles", "location_display", "salary_raw", "salary_normalized",
              "posted_at", "relevant", "match", "needs_human_check", "dealbreakers",
              "unknowns", "reasoning", "is_repost", "repost_of", "apply_url"]
    data = []
    for r in rows:
        snap = company_snapshot(r.get("source_url"), r.get("source"))
        salary = normalize_salary(r.get("salary_display") or "")
        if not salary and r.get("description_markdown"):
            salary = normalize_salary(r["description_markdown"][:800])
        data.append([
            r.get("source", ""), r.get("source_id", ""), r.get("title", ""),
            r.get("company_name", ""), snap["source_board"], snap["board_url"],
            snap["open_roles"] if snap["open_roles"] is not None else "",
            r.get("location_display", ""), r.get("salary_display", "") or "", salary,
            (r.get("posted_at") or "")[:10], r.get("relevant"), r.get("match"),
            r.get("needs_human_check"), "; ".join(r.get("dealbreakers_hit", []) or []),
            "; ".join(r.get("unknowns", []) or []), r.get("reasoning", ""),
            r.get("is_repost"), r.get("repost_of"), r.get("source_url", ""),
        ])
    if fmt == "xlsx":
        try:
            from openpyxl import Workbook
        except Exception:
            print("openpyxl not installed; writing CSV instead")
            fmt = "csv"
    if fmt == "xlsx":
        from openpyxl import Workbook
        wb = Workbook(); ws0 = wb.active; ws0.title = "matches"
        ws0.append(header)
        for row in data:
            ws0.append(row)
        wb.save(out)
    else:
        with open(out, "w", encoding="utf-8", newline="") as f:
            import csv
            w = csv.writer(f)
            w.writerow(header)
            w.writerows(data)
    print(f"exported {len(data)} matches -> {out}")


def main(argv):
    if not argv:
        err("usage", "no command", False)
    if argv[0] == "--version":
        print(VERSION)
        sys.exit(0)
    if argv[0] == "whoami":
        cmd_whoami()
    if argv[0] == "docs":
        listing = argv[1] if len(argv) > 1 else LISTING
        cmd_docs(listing)
    if argv[0] == "probe-registry":
        cmd_probe_registry()
        sys.exit(0)
    if argv[0] == "discover-slugs":
        cmd_discover_slugs()
        sys.exit(0)
    if argv[0] == "export-matches":
        cmd_export_matches()
        sys.exit(0)
    if argv[0] == "report":
        cmd_report()
        sys.exit(0)
    if argv[0] == "call":
        if len(argv) < 3:
            err("usage", "call LISTING ROUTE [args]", False)
        listing = argv[1]
        slug = argv[2]
        rest = argv[3:]
        if slug == "search-jobs":
            cmd_search(rest, listing)
        if slug == "get-posting":
            cmd_get_posting(rest, listing)
        err("unsupported", f"unhandled route: {slug}", False)
    err("unsupported", f"unhandled args: {argv}", False)


if __name__ == "__main__":
    main(sys.argv[1:])
