        err("validation_error", "posting_id and source_url are required", False)

    row = find_row_in_cache(source, posting_id)
    if row is None:
        # try to fetch live (fresh board) in case cache expired
        try:
            if source == "ashby":
                reg = load_registry()
                for org in reg.get("ashby", []):
                    for r in fetch_ashby(org):
                        if str(r.get("source_id")) == str(posting_id):
                            row = r
                            break
                    if row:
                        break
            elif source == "greenhouse":
                reg = load_registry()
                for org in reg.get("greenhouse", []):
                    for r in fetch_greenhouse(org):
                        if str(r.get("source_id")) == str(posting_id):
                            row = r
                            break
                    if row:
                        break
            elif source == "lever":
                reg = load_registry()
                for org in reg.get("lever", []):
                    for r in fetch_lever(org):
                        if str(r.get("source_id")) == str(posting_id):
                            row = r
                            break
                    if row:
                        break
            elif source == "remotive":
                for r in fetch_remotive(""):
                    if str(r.get("source_id")) == str(posting_id):
                        row = r
                        break
            elif source == "remoteok":
                for r in fetch_remoteok(""):
                    if str(r.get("source_id")) == str(posting_id):
                        row = r
                        break
            elif source == "weworkremotely":
                for r in fetch_weworkremotely(""):
                    if str(r.get("source_id")) == str(posting_id):
                        row = r
                        break
        except Exception:
            pass

    if row is None:
        err("validation_error", "posting not found on this board set", False,
            param="posting_id")

    # full description per source
    description = row.get("_desc") or ""
    apply_url = row.get("source_url") or ""
    etype = row.get("employment_type") or ""
    remote = row.get("is_remote")
    wtype = row.get("workplace_type") or ""
    if not description:
        # fallback: live per-job fetch, using the board org we recorded
        org = row.get("_org") or ""
        if not org:
            m = re.search(r"boards\.greenhouse\.io/v1/boards/([^/]+)", source_url)
            org = m.group(1) if m else ""
        try:
            if source == "ashby" and org:
                data = fetch_json(
                    f"https://api.ashbyhq.com/posting-api/job-board/{org}?includeCompensation=true")
                for j in data.get("jobs", []) or []:
                    if str(j.get("id")) == str(posting_id):
                        description = j.get("descriptionPlain") or _strip_html(j.get("descriptionHtml") or "")
                        apply_url = j.get("applyUrl") or j.get("jobUrl") or apply_url
                        etype = etype or str(j.get("employmentType") or "")
                        break
            elif source == "greenhouse" and org:
                d = fetch_json(f"https://boards-api.greenhouse.io/v1/boards/{org}/jobs/{posting_id}?questions=false")
                description = d.get("content") or ""
                apply_url = d.get("absolute_url") or apply_url
            elif source == "lever" and org:
                d = fetch_json(f"https://api.lever.co/v0/postings/{org}?mode=json")
                for j in d:
                    if str(j.get("id")) == str(posting_id):
                        description = j.get("descriptionPlain") or ""
                        apply_url = j.get("applyUrl") or j.get("hostedUrl") or apply_url
                        break
        except Exception:
            pass
    if not description:
        try:
            if source.startswith("aa/"):
                rows, _ = fetch_via_api_anything(source, "", "", 300)
                for r in rows:
                    if str(r.get("source_id")) == str(posting_id):
                        description = r.get("_desc") or ""
                        apply_url = r.get("source_url") or apply_url
                        break
            elif source == "linkedin":
                raw = http_get(f"https://www.linkedin.com/jobs-guest/jobs/view/{posting_id}",
                               want_json=False)
                m = re.search(r'show-more-less-html__markup[^>]*>(.*?)</div>',
                              raw, re.S)
                if m:
                    description = _strip_html(m.group(1))
            elif source == "remotive":
                data = fetch_json("https://remotive.com/api/remote-jobs?limit=200")
                for j in data.get("jobs", []) or []:
                    if str(j.get("id")) == str(posting_id):
                        description = j.get("description") or ""
                        apply_url = j.get("url") or apply_url
                        break
            elif source == "remoteok":
                try:
                    data = fetch_json("https://remoteok.com/api")
                except Exception:
                    data = []
                for j in data[1:]:
                    if str(j.get("id")) == str(posting_id):
                        description = j.get("description") or ""
                        apply_url = j.get("url") or j.get("apply_url") or apply_url
                        break
            elif source == "weworkremotely":
                raw = http_get(source_url, want_json=False)
                m = re.search(r'<div class="job-description"[^>]*>(.*?)</div>', raw, re.S)
                if m:
                    description = _strip_html(m.group(1))
        except Exception:
            pass

    resp = {
