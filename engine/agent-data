def _now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _req_id():
    return "req_local_" + hashlib.sha1(
        (str(time.time()) + os.urandom(4).hex()).encode()).hexdigest()[:16]


def out(obj):
    print(json.dumps(obj, ensure_ascii=False))
    sys.exit(0)


def err(code, message, retryable, param=None):
    body = {"code": code, "message": message, "retryable": retryable,
            "param": param, "request_id": _req_id(), "source": "local"}
    print(json.dumps({"error": body}, ensure_ascii=False), file=sys.stderr)
    sys.exit(1)


def http_get(url, want_json=True, timeout=TIMEOUT):
    req = urllib.request.Request(url, headers={"User-Agent": UA,
                                               "Accept": "*/*"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read().decode("utf-8", "replace")
    if want_json:
        return json.loads(raw)
    return raw


def fetch_json(url):
    """fetch with throttle; raise on any upstream problem"""
    time.sleep(MIN_SLEEP)
    return http_get(url)


def cache_get(key, ttl=CACHE_TTL):
    path = os.path.join(CACHE_DIR, hashlib.sha1(key.encode()).hexdigest() + ".json")
    if os.path.exists(path):
        if time.time() - os.path.getmtime(path) < ttl:
            with open(path, encoding="utf-8") as f:
                return json.load(f)
    return None


def cache_put(key, data):
    path = os.path.join(CACHE_DIR, hashlib.sha1(key.encode()).hexdigest() + ".json")
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)


def load_registry():
    path = os.path.join(ROOT, "sources.json")
    if not os.path.exists(path):
        return {}
    with open(path, encoding="utf-8") as f:
        return json.load(f)


def flag(argv, name):
    if name in argv:
        i = argv.index(name)
        if i + 1 < len(argv):
            return argv[i + 1]
    return None


