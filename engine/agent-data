def cmd_search(argv, listing):
    source = flag(argv, "--source") or "linkedin"
    if source not in FETCHERS and not source.startswith("aa/"):
        err("validation_error", f"Unsupported source {source!r}. Allowed: "
            + ", ".join(sorted(FETCHERS)) + ", or aa/<site>/<op>", False, param="source")
    keywords = flag(argv, "--keywords") or ""
    location = flag(argv, "--location") or ""
    limit_s = flag(argv, "--limit") or "25"
    try:
        limit = int(limit_s)
    except ValueError:
        err("validation_error", "limit must be an integer", False, param="limit")
    cutoff = flag(argv, "--published_on_or_after")
    if cutoff is not None and not re.match(r"\d{4}-\d{2}-\d{2}", cutoff):
        err("validation_error", "published_on_or_after must be YYYY-MM-DD",
            False, param="published_on_or_after")

    rows, ferr = fetch_source_rows(source, keywords, location, cutoff)
    if ferr:
        err("upstream_unavailable", ferr, True)

    limited = rows[:limit]
    # strip internal fields
    clean = []
    for r in limited:
        out_row = {k: v for k, v in r.items() if k not in ("tags", "category", "_org")}
        clean.append(out_row)

    resp = {
        "data": {
            "query": {"source": source, "keywords": keywords,
                      "location": location,
                      "published_on_or_after": cutoff or None},
            "results": clean,
            "pagination": {"next_cursor": None, "has_more": False},
        },
        "meta": {"request_id": _req_id()},
    }
    out(resp)


def find_row_in_cache(source, posting_id):
    """recover the surfaced row by id from cached boards; returns row dict or None"""
    if source == "linkedin":
        return {"source": source, "source_id": posting_id, "id": posting_id,
                "source_url": f"https://www.linkedin.com/jobs/view/{posting_id}",
                "title": "", "company_name": "", "location_display": "",
                "_org": ""}
    if source.startswith("aa/"):
        return {"source": source, "source_id": posting_id, "id": posting_id,
                "source_url": source_url, "title": "", "company_name": "",
                "location_display": "", "_org": ""}
    reg = load_registry()
    if source in ("ashby", "greenhouse", "lever"):
        for org in reg.get(source, []):
            cached = cache_get(f"{source}:{org}")
            if not isinstance(cached, list):
                continue
            for r in cached:
                if str(r.get("source_id")) == str(posting_id):
                    return r
    return None


def cmd_get_posting(argv, listing):
    source = flag(argv, "--source") or ""
    posting_id = flag(argv, "--posting_id") or ""
    source_url = flag(argv, "--source_url") or ""
