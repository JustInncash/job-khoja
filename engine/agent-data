def _strip_html(s):
    if not s:
        return ""
    s = re.sub(r"<[^>]+>", " ", s)
    s = re.sub(r"&nbsp;", " ", s)
    s = re.sub(r"&amp;", "&", s)
    s = re.sub(r"&lt;", "<", s)
    s = re.sub(r"&gt;", ">", s)
    s = re.sub(r"&#39;|&apos;", "'", s)
    s = re.sub(r"&quot;", '"', s)
    s = re.sub(r"\s+", " ", s)
    return s.strip()


def _iso(txt):
    """best-effort -> ISO string usable for ordering ('2026-08-01...')."""
    if txt is None or txt == "":
        return None
    if isinstance(txt, (int, float)):
        # epoch seconds or ms
        try:
            return datetime.fromtimestamp(txt / 1000 if txt > 1e11 else txt,
                                         tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        except Exception:
            return None
    txt = str(txt).strip()
    m = re.match(r"(\d{4}-\d{2}-\d{2})", txt)
    if not m:
        return None
    return m.group(1)


def _eff_date(row):
    vals = []
    for v in (row.get("published_at"), row.get("posted_at")):
        iso = _iso(v)
        if iso:
            vals.append(iso)
    return max(vals)[:10] if vals else None


# Domain synonym families used by the relaxed matcher. Query tokens expand
# into these families, so "QA" matches "Quality Assurance Engineer".
FAMILIES = {
    "qa": {"qa", "quality"},
    "test": {"test", "testing", "tester", "tests", "qe"},
    "analyst": {"analyst"},
    "engineer": {"engineer"},
    "software": {"software"},
    "automation": {"automation"},
    "manual": {"manual"},
    "junior": {"junior"},
    "fresher": {"fresher", "entry", "graduate", "trainee"},
    "sdet": {"sdet"},
    "sql": {"sql"},
    "java": {"java"},
    "selenium": {"selenium"},
    "remote": {"remote"},
}
QA_DOMAIN = {"qa", "quality", "test", "testing", "tester", "sdet",
             "qe", "automation"}


def _families(tokens):
    fams = []
    for t in tokens:
        fam = FAMILIES.get(t, {t})
        # merge into existing family set if overlapping
        merged = False
        for f in fams:
            if f & fam:
                f |= fam
                merged = True
                break
        if not merged:
            fams.append(set(fam))
    return fams


def _tokenize(text):
    return [t for t in re.split(r"[^a-z0-9+#]+", text.lower()) if t]


def _relative_date(txt, now=None):
    """'3 days ago' / 'yesterday' / 'today' -> ISO date (UTC)."""
    if not txt:
        return None
    now = now or datetime.now(timezone.utc)
    t = txt.strip().lower()
    if "today" in t or t in ("now", "just now"):
        return now.strftime("%Y-%m-%dT%H:%M:%SZ")
    if "yesterday" in t:
        return (now - datetime.timedelta(days=1)).strftime("%Y-%m-%dT%H:%M:%SZ")
    m = re.match(r"(\d+)\s*(day|week|month)s?\s*ago", t)
    if not m:
        return None
    n = int(m.group(1)); unit = m.group(2)
    days = n * {"day": 1, "week": 7, "month": 30}[unit]
    return (now - datetime.timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%SZ")


def _match_keywords(row, keyword_text):
    """Relaxed full-text match with synonym families. A row matches when:
    - every query family appears in the haystack, or
    - at least half the families appear in the haystack AND at least one hits
      the title, or
    - the query is QA-domain and any QA-domain family hits the title.
    """
    if not keyword_text:
        return True
    toks = [t for t in re.split(r"[^a-z0-9+#]+", keyword_text.lower()) if t]
    if not toks:
        return True
    # LinkedIn behaviour mirrors a board search: any keyword family matching
    # the title OR company keeps the row (broader recall, judgment filters).
    if row.get("source") == "linkedin":
        title = str(row.get("title", "")).lower()
        company = str(row.get("company_name", "")).lower()
        fams = _families(toks)
        return any(any(m in title or m in company for m in f) for f in fams)
    hay = " ".join([
        str(row.get("title", "")), str(row.get("company_name", "")),
        str(row.get("location_display", "")),
    ]).lower()
    title = str(row.get("title", "")).lower()
    fams = _families(toks)
    in_hay = sum(1 for f in fams if any(m in hay for m in f))
    in_title = any(any(m in title for m in f) for f in fams)
    if in_hay >= len(fams):
        return True
    # A QA-domain query only short-circuits on a QA term actually present.
    if any(t in QA_DOMAIN for t in toks):
        qa_hit = any(
            t in QA_DOMAIN and any(m in hay for m in FAMILIES.get(t, {t}))
            for t in toks)
        if qa_hit:
            return True
    return in_title and in_hay >= max(1, (len(fams) + 1) // 2)


def _match_location(row, loc_text):
    # A remote posting is compatible with any requested geography unless the
    # user explicitly asked for a specific on-site place; remote always passes.
    loc = str(row.get("location_display", "")).lower()
    if "remote" in loc:
        return True
    if not loc_text:
        return True
    want = loc_text.lower()
    if want in loc:
        return True
    # allow a word-level match for multi-word geographies (e.g. "Kolkata")
    words = [w for w in re.split(r"[^a-z ]", want) if len(w) > 3]
    if words and any(w in loc for w in words):
        return True
    return False


def _match_freshness(row, cutoff):
    if not cutoff:
        return True
    d = _eff_date(row)
    return d is not None and d >= cutoff[:10]


