            "source_id": row.get("source_id"),
            "description_markdown": description,
            "employment_type": etype,
            "apply_url": apply_url,
            "is_listed": True,
            "is_remote": remote,
            "workplace_type": wtype,
            "staleness_status": "fresh",
        },
        "meta": {"request_id": _req_id()},
    }
    out(resp)


def cmd_probe_registry():
    """agent-data probe-registry --manifest m.json --out sources.json
    Tries each candidate (platform, org) against the public board APIs and keeps
    only boards that answer. Writes the registry used by search."""
    manifest_path = flag(sys.argv[2:], "--manifest") or os.path.join(ROOT, "manifest.json")
    out_path = flag(sys.argv[2:], "--out") or os.path.join(ROOT, "sources.json")
    with open(manifest_path, encoding="utf-8") as f:
        manifest = json.load(f)

    registry = {"ashby": [], "greenhouse": [], "lever": []}
    report = []
    for platform, orgs in manifest.items():
        for org in orgs:
            try:
                if platform == "ashby":
                    url = f"https://api.ashbyhq.com/posting-api/job-board/{org}?includeCompensation=true"
                    data = fetch_json(url)
                    n = len(data.get("jobs", []) or [])
                    if n >= 0:
                        registry["ashby"].append(org)
                        report.append(f"ashby {org}: {n} jobs")
                elif platform == "greenhouse":
                    url = f"https://boards-api.greenhouse.io/v1/boards/{org}/jobs?per_page=1"
                    data = fetch_json(url)
                    n = data.get("meta", {}).get("total", 0) if isinstance(data.get("meta"), dict) else len(data.get("jobs") or [])
                    registry["greenhouse"].append(org)
                    report.append(f"greenhouse {org}: {n} jobs")
                elif platform == "lever":
                    url = f"https://api.lever.co/v0/postings/{org}?mode=json&limit=1"
                    data = fetch_json(url)
                    if isinstance(data, list):
                        n = len(data)
                        registry["lever"].append(org)
                        report.append(f"lever {org}: {n} jobs listed")
            except Exception as e:
                report.append(f"FAIL {platform} {org}: {e}")
            time.sleep(0.15)
    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(registry, f, indent=2)
    print("\n".join(report))
    print(f"\nregistry written to {out_path}")
    print(f"ashby={len(registry['ashby'])} greenhouse={len(registry['greenhouse'])} lever={len(registry['lever'])}")


def _cdx_slugs(source, limit=8000):
    """Enumerate board slugs from the Internet Archive CDX API (free, no key).
    Mirrors the full-index crawl the metered service maintains."""
    domains = {
        "greenhouse": ("boards.greenhouse.io", "/jobs"),
        "ashby": ("jobs.ashbyhq.com", ""),
        "lever": ("jobs.lever.co", ""),
    }
    domain, needle = domains[source]
    url = (f"http://web.archive.org/cdx/search/cdx?url={domain}/*"
           f"&output=json&collapse=urlkey&fl=original"
           f"&filter=statuscode:200&filter=original:.*{needle}.*"
           f"&limit={limit}")
    data = http_get(url, want_json=True)
    slugs = set()
    if isinstance(data, list) and len(data) > 1:
        for row in data[1:]:
            if not row:
                continue
            h = row[0] if isinstance(row, list) else str(row)
            m = None
            if source == "greenhouse":
                m = re.search(r"boards\.greenhouse\.io/([^/?#]+)", h)
            elif source == "ashby":
                m = re.search(r"jobs\.ashbyhq\.com/([^/?#]+)", h)
            else:
                m = re.search(r"jobs\.lever\.co/([^/?#]+)", h)
            if m:
                slug = m.group(1).lower().strip()
                if len(slug) >= 2 and not slug.isdigit():
                    slugs.add(slug)
    return sorted(slugs)


def discover_slugs_for(source, max_pages=3):
    """Harvest candidate company board slugs from the public web archive, then
    verify each against the live board API. Mirrors how the metered service
    builds a full ATS index — but free and local."""
    patterns = {
        "greenhouse": "site:boards.greenhouse.io/jobs",
        "ashby": "site:jobs.ashbyhq.com",
        "lever": "site:jobs.lever.co",
    }
    if source not in patterns:
        return {"error": f"no discovery pattern for {source}"}
    candidates = []
    for attempt in range(3):
        try:
            candidates = _cdx_slugs(source)
            break
        except Exception as e:
            if attempt == 2:
                return {"error": f"cdx failed: {e}"}
            time.sleep(2)
    valid = []
    for slug in candidates:
        try:
            FETCHERS[source](slug)
            valid.append(slug)
        except Exception:
            continue
    return {"candidates": len(candidates), "discovered": len(valid), "valid": valid}


def cmd_discover_slugs():
    src = flag(sys.argv[2:], "--source") or "all"
    targets = [src] if src != "all" else ["greenhouse", "ashby", "lever"]
    reg = load_registry()
    for s in targets:
        res = discover_slugs_for(s)
        if "valid" not in res:
            print(s, "->", res)
            continue
        before = len(reg.get(s, []))
        added = [x for x in res["valid"] if x not in reg.get(s, [])]
        reg.setdefault(s, []).extend(added)
        reg[s] = sorted(set(reg[s]))
        print(f"{s}: candidates={res['candidates']} discovered={res['discovered']} "
              f"added={len(added)} (was {before}, now {len(reg[s])})")
    path = os.path.join(ROOT, "sources.json")
    with open(path, "w", encoding="utf-8") as f:
        json.dump(reg, f, indent=2)
    print("registry updated:", {k: len(v) for k, v in reg.items()})


