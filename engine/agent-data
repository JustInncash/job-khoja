def _canon(row, source, srcid, url, title, company, loc="", salary="",
           etype="", dept="", team="", remote=None, wtype="",
           posted="", published="", detail_available=True, tags=None, cat="",
           org=""):
    row.update({
        "source": source, "source_id": srcid, "id": srcid, "source_url": url,
        "title": title, "company_name": company, "location_display": loc,
        "salary_display": salary, "employment_type": etype,
        "department_name": dept, "team_name": team, "is_remote": remote,
        "workplace_type": wtype, "posted_at": posted, "published_at": published,
        "detail_available": detail_available,
        "tags": tags or [], "category": cat, "_org": org,
    })
    return row


def fetch_ashby(org):
    url = f"https://api.ashbyhq.com/posting-api/job-board/{org}?includeCompensation=true"
    data = fetch_json(url)
    rows = []
    for j in data.get("jobs", []) or []:
        jid = j.get("id") or ""
        loc = j.get("location") or ""
        if not loc and j.get("address"):
            loc = (j.get("address") or {}).get("addressLine") or ""
        remote = bool(j.get("isRemote"))
        if remote and not loc:
            loc = "Remote"
        comp = (j.get("compensation") or {}) or {}
        sal = comp.get("compensationTierSummary") or comp.get("compensationDescription") or ""
        desc = j.get("descriptionPlain") or _strip_html(j.get("descriptionHtml") or "")
        rows.append(_canon(
            {}, "ashby", str(jid), j.get("jobUrl") or "",
            j.get("title") or "", org.replace("-", " ").title(),
            str(loc), str(sal), str(j.get("employmentType") or ""),
            str(j.get("department") or ""), str(j.get("team") or ""),
            remote, "Remote" if remote else "", j.get("publishedAt") or "",
            "", True, org=org,
        ))
        rows[-1]["_desc"] = desc
    return rows


def fetch_greenhouse(org):
    rows = []
    page = 1
    url = (f"https://boards-api.greenhouse.io/v1/boards/{org}/jobs"
           f"?content=true&per_page=100&page={page}")
    while True:
        data = fetch_json(url)
        jobs = data.get("jobs") or []
        for j in jobs:
            jid = str(j.get("id") or "")
            loc = ((j.get("location") or {}) or {}).get("name") or ""
            meta = j.get("metadata") or []
            etype = ""
            for m in meta:
                if str(m.get("name", "")).lower() in ("employment type", "employment_type"):
                    etype = str(m.get("value") or "")
                    break
            dept = ""
            depts = j.get("departments") or []
            if depts:
                dept = str(depts[0].get("name") or "")
            office = ""
            offices = j.get("offices") or []
            if offices:
                office = str(offices[0].get("name") or "")
            rows.append(_canon(
                {}, "greenhouse", jid, j.get("absolute_url") or "",
                j.get("title") or "", str(j.get("company_name") or org.replace("-", " ").title()),
                str(loc), "", etype, dept, office, None, "",
                j.get("first_published") or "", j.get("updated_at") or "", True,
                org=org,
            ))
            rows[-1]["_desc"] = _strip_html(j.get("content") or "")
        if not data.get("next_page") or not jobs:
            break
        page += 1
        url = (f"https://boards-api.greenhouse.io/v1/boards/{org}/jobs"
               f"?content=true&per_page=100&page={page}")
    return rows


def fetch_lever(org):
    url = f"https://api.lever.co/v0/postings/{org}?mode=json"
    data = fetch_json(url)
    rows = []
    if not isinstance(data, list):
        return rows
    for j in data:
        jid = str(j.get("id") or "")
        cats = j.get("categories") or {}
        loc = str(cats.get("location") or cats.get("allLocations") or "")
        if isinstance(cats.get("allLocations"), list):
            loc = "; ".join(str(x) for x in cats["allLocations"])
        wtype = str(j.get("workplaceType") or "")
        sr = j.get("salaryRange") or {}
        sal = ""
        if sr.get("min") or sr.get("max"):
            sal = f"{sr.get('currency') or ''} {sr.get('min')} – {sr.get('max')} {sr.get('interval') or ''}".strip()
        rows.append(_canon(
            {}, "lever", jid, j.get("hostedUrl") or j.get("applyUrl") or "",
            j.get("text") or "", org.replace("-", " ").title(),
            loc, sal, str(cats.get("commitment") or ""),
            str(cats.get("team") or ""), str(cats.get("department") or ""),
            "remote" in wtype.lower(), wtype,
            j.get("firstPublishedAt") or "", j.get("createdAt") or "", True,
            org=org,
        ))
        rows[-1]["_desc"] = j.get("descriptionPlain") or ""
    return rows


def fetch_linkedin(keywords, location, limit=25):
    """LinkedIn guest jobs search, adaptive-depth (mirrors agent-data's deep
    crawl). Keeps paginating until the result set is exhausted (a page yields
    no new cards) or MAX_LINKEDIN_PAGES pages are fetched (default 24 = 600
    raw rows), or enough matching rows are collected. Fine to stop early."""
    rows = []
    max_pages = int(os.environ.get("MAX_LINKEDIN_PAGES", "60"))
    target_rows = max(limit * 6, 50)  # collect enough before trimming to limit
    start = 0
    while start <= (max_pages - 1) * 25:
        params = [("keywords", keywords)] if keywords else []
        if location:
            params.append(("location", location))
        params.append(("start", str(start)))
        qs = "&".join(f"{k}={urllib.parse.quote(str(v))}" for k, v in params)
        url = f"https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?{qs}"
        try:
            html = http_get(url, want_json=False)
        except Exception:
            break
        cards = re.split(r'(?=<li>)', html)
        got = 0
        for card in cards:
            if "base-card" not in card:
                continue
            mlink = re.search(r'jobs/view/[^"]*?(\d{6,})(?:[?&"]|$)', card)
            mtitle = re.search(r'base-search-card__title">(.*?)</h3>', card, re.S)
            mcomp = re.search(r'base-search-card__subtitle">(.*?)</h4>', card, re.S)
            mloc = re.search(r'job-search-card__location">(.*?)</span>', card, re.S)
            mdate = re.search(r'job-search-card__listdate[^>]*datetime="([^"]+)"', card)
            rel = None
            if not mdate:
                mdate = re.search(r'job-search-card__listdate[^>]*>(.*?)</time>', card, re.S)
                if mdate:
                    rel = _strip_html(mdate.group(1))
            if not mlink or not mtitle:
                continue
            jid = mlink.group(1)
            title = _strip_html(mtitle.group(1))
            company = _strip_html(mcomp.group(1)) if mcomp else ""
            loc = _strip_html(mloc.group(1)) if mloc else ""
            posted = ""
            if mdate and mdate.group(1):
                posted = mdate.group(1)
            elif rel:
                posted = _relative_date(rel) or ""
            url_job = f"https://www.linkedin.com/jobs/view/{jid}"
            rows.append(_canon(
                {}, "linkedin", jid, url_job, title, company, loc,
                "", "", "", "", None, "", posted, posted, True,
            ))
            got += 1
        if got == 0:
            break  # exhausted
        if len(rows) >= target_rows:
            break  # enough raw matches before hitting the page cap
        start += 25
        if start <= (max_pages - 1) * 25:
            time.sleep(0.9)  # be polite to LinkedIn between pages
    return rows


def fetch_remotive(keywords):
    # Remotive's ?search= param is ignored server-side; pull the software-dev
    # category and let the local matcher do the keyword filtering.
    url = "https://remotive.com/api/remote-jobs?category=software-dev&limit=100"
    data = fetch_json(url)
    rows = []
    for j in data.get("jobs", []) or []:
        jid = str(j.get("id") or "")
        tags = [str(t) for t in (j.get("tags") or [])]
        rows.append(_canon(
            {}, "remotive", jid, j.get("url") or "",
            j.get("title") or "", str(j.get("company_name") or ""),
            str(j.get("candidate_required_location") or "Remote"),
            str(j.get("salary") or ""), str(j.get("job_type") or ""),
            str(j.get("category") or ""), "", None, "",
            j.get("publication_date") or "", j.get("publication_date") or "", True,
            tags, str(j.get("category") or ""),
        ))
    return rows


def fetch_remoteok(keywords):
    data = fetch_json("https://remoteok.com/api")
    rows = []
    if not isinstance(data, list):
        return rows
    for j in data[1:]:  # first element is a notice
        jid = str(j.get("id") or "")
        tags = [str(t) for t in (j.get("tags") or [])]
        rows.append(_canon(
            {}, "remoteok", jid, j.get("url") or j.get("apply_url") or "",
            j.get("position") or "", str(j.get("company") or ""),
            str(j.get("location") or "Remote"), str(j.get("salary_min") or ""),
            "", "", "", None, "", j.get("date") or "", j.get("date") or "",
            True, tags, "",
        ))
    return rows


def fetch_weworkremotely(keywords):
    raw = http_get(
        "https://weworkremotely.com/categories/remote-programming-jobs.rss",
        want_json=False)
    # Safety: only parse feeds that carry no DTD/entity declarations (XXE /
    # billion-laughs guard). The trusted RSS source never sends one.
    if "<!DOCTYPE" in raw or "<!ENTITY" in raw:
        return []
    root = ET.fromstring(raw)
    rows = []
    for item in root.iter("item"):
        title = (item.findtext("title") or "").strip()
        link = (item.findtext("link") or "").strip()
        desc = (item.findtext("description") or "").strip()
        pub = (item.findtext("pubDate") or "").strip()
        m = re.search(r"\d{4}-\d{2}-\d{2}", pub)
        posted = m.group(0) if m else ""
        company = ""
        if ":" in title:
            maybe_company, maybe_title = title.split(":", 1)
            if maybe_company.strip() and maybe_title.strip():
                company = maybe_company.strip()
                title = maybe_title.strip()
        hay = (title + " " + desc).lower()
        rows.append(_canon(
            {}, "weworkremotely",
            hashlib.sha1(link.encode()).hexdigest()[:16], link, title, company,
            "Remote", "", "", "", "", None, "", posted, posted, True, [], "",
        ))
    return rows


FETCHERS = {
    "linkedin": fetch_linkedin,
    "ashby": fetch_ashby,
    "greenhouse": fetch_greenhouse,
    "lever": fetch_lever,
    "remotive": fetch_remotive,
    "remoteok": fetch_remoteok,
    "weworkremotely": fetch_weworkremotely,
}


def fetch_source_rows(source, keywords, location, cutoff):
    """returns (rows, error_or_None)"""
    reg = load_registry()
    if source.startswith("aa/"):
        return fetch_via_api_anything(source, keywords, location, cutoff)
    if source in ("ashby", "greenhouse", "lever"):
        orgs = reg.get(source, [])
        if not orgs:
            return [], f"no {source} boards in registry (run probe-registry or add to sources.json)"
        all_rows = []
        for org in orgs:
            key = f"{source}:{org}"
            cached = cache_get(key)
            if cached is None:
                try:
                    cached = FETCHERS[source](org)
                except Exception as e:  # one board down != source down
                    continue
                cache_put(key, cached)
            if isinstance(cached, list):
                all_rows.extend(cached)
        rows = all_rows
    elif source == "linkedin":
        try:
            rows = FETCHERS[source](keywords, location, 25)
        except Exception as e:
            return [], f"linkedin upstream failed: {e}"
    elif source == "remotive":
        try:
            rows = FETCHERS[source](keywords)
        except Exception as e:
            return [], f"remotive upstream failed: {e}"
    elif source == "remoteok":
        try:
            rows = FETCHERS[source](keywords)
        except Exception as e:
            return [], f"remoteok upstream failed: {e}"
    elif source == "weworkremotely":
        try:
            rows = FETCHERS[source](keywords)
        except Exception as e:
            return [], f"weworkremotely upstream failed: {e}"
    else:
        return [], f"Unsupported source {source!r}. Allowed: linkedin, ashby, greenhouse, lever, remotive, remoteok, weworkremotely, or aa/<site>/<op> (api-anything catalog)"

    matched = []
    for r in rows:
        if not r.get("title") or not r.get("source_id") or not r.get("source_url"):
            continue
        if not _match_keywords(r, keywords):
            continue
        if not _match_location(r, location):
            continue
        if not _match_freshness(r, cutoff):
            continue
        matched.append(r)

    matched.sort(key=lambda r: (_eff_date(r) or ""), reverse=True)
    return matched, None


